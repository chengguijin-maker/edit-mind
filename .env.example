# Keys
SESSION_SECRET=""
ENCRYPTION_KEY=""

# Media (Important)
HOST_MEDIA_PATH="/path/to/your/media/folder"

# Local Ollama Option (Recommend)
OLLAMA_MODEL="qwen2.5:7b-instruct"
USE_OLLAMA_MODEL="false"
OLLAMA_HOST=""
OLLAMA_PORT=""

# Gemini Option
GEMINI_API_KEY=""
USE_GEMINI="false"

# Ports Mapping 
CHROMA_PORT=8000 
PORT=3745 
BACKGROUND_JOBS_PORT=4000 
ML_PORT=8765  
REDIS_PORT=6379
POSTGRES_PORT=5432  

# Processing concurrency
MAX_CONCURRENT_TRANSCRIPTIONS="1"
MAX_CONCURRENT_ANALYSES="1"
AUDIO_EMBEDDING_WORKER_CONCURRENCY="2"
VISUAL_EMBEDDING_WORKER_CONCURRENCY="2"

# Embedding throughput tuning
AUDIO_EMBEDDING_BATCH_SIZE="4"
VISUAL_EMBEDDING_BATCH_SIZE="4"
AUDIO_EMBEDDING_BATCH_CONCURRENCY="2"
VISUAL_EMBEDDING_BATCH_CONCURRENCY="2"
VISUAL_EMBEDDING_FRAMES_PER_SCENE="3"

# Optional feature toggles
DISABLE_AUDIO_EMBEDDINGS="false"
DISABLE_VISUAL_EMBEDDINGS="false"
